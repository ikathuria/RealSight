# Backend (copy to apps/backend/.env locally; set on Cloud Run for deploy)

# Gemini auth — option A: API key from https://aistudio.google.com
GOOGLE_API_KEY=

# Gemini auth — option B: Vertex AI (instead of API key)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MDB_MCP_CONNECTION_STRING=

# Extension backend URL lives in apps/extension/config.js (not an env var)
